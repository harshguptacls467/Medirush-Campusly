# ─── Google Gemini ────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Twilio WhatsApp ──────────────────────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio WhatsApp Sandbox sender (or your approved number):
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Chemist's WhatsApp number to receive orders (must be enrolled in sandbox):
CHEMIST_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# ─── Public URL ───────────────────────────────────────────────────────────────
# MUST be a publicly reachable URL for the Accept link in WhatsApp messages.
# For local hackathon testing: expose localhost with ngrok or Cloudflare Tunnel:
#   ngrok:             ngrok http 3000  -> use the https://xxxx.ngrok-free.app URL
#   Cloudflare Tunnel: cloudflared tunnel --url http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Supabase (optional — not currently used) ────────────────────────────────
# The app currently uses file-based persistence (.medirush-orders.json).
# Upgrade to Supabase only if you need multi-instance/production persistence.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
